# SasakBPF Lab Secrets — populate from Discord Developer Portal
# This file is gitignored. Do NOT commit. Do NOT share.
#
# Format:
#   export SD_BOT_TOKEN="Bot <token>"
#   export SD_CHANNEL_ID="<command-channel-id>"
#   export SD_TARGET_ID="<unique-implant-id>"
#   export SD_AES_KEY_HEX="<32-byte hex key>"
#
# Generate AES key:
#   openssl rand -hex 32